---
import "@/styles/global.css";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import { site } from "@/data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.svg", Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  description: site.description,
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: site.description,
  offers: [
    { "@type": "Offer", name: "Starter", price: "19", priceCurrency: "USD" },
    { "@type": "Offer", name: "Pro", price: "39", priceCurrency: "USD" },
    { "@type": "Offer", name: "Business", price: "79", priceCurrency: "USD" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-5GWNPPMP");
    </script>
    <!-- End Google Tag Manager -->
    <script>
      // Captures utm_source/medium/campaign off the landing URL into
      // sessionStorage so the demo form can attach them even if the visitor
      // scrolls to it well after arriving. Only overwrites the stored value
      // when the current URL actually carries UTM params, so a later
      // in-session navigation without them doesn't erase the original
      // attribution (first-touch-per-session).
      const utmParams = new URLSearchParams(window.location.search);
      const utm = {
        utm_source: utmParams.get("utm_source"),
        utm_medium: utmParams.get("utm_medium"),
        utm_campaign: utmParams.get("utm_campaign"),
      };

      if (Object.values(utm).some(Boolean)) {
        sessionStorage.setItem("flowbase:utm", JSON.stringify(utm));
      }
    </script>
    <script>
      // Basic A/B test: assign/read the primary-CTA label variant before the
      // body paints (avoids a flash of the wrong label), persist it so the
      // same visitor keeps seeing it across sessions, and report the
      // impression to GA4 via the dataLayer. ?ab_variant=a|b in the URL
      // forces and re-persists a variant, for QA/demoing.
      const AB_STORAGE_KEY = "flowbase:abVariant";
      const forcedVariant = new URLSearchParams(window.location.search).get(
        "ab_variant",
      );

      let abVariant;
      if (forcedVariant === "a" || forcedVariant === "b") {
        abVariant = forcedVariant;
        localStorage.setItem(AB_STORAGE_KEY, abVariant);
      } else {
        const stored = localStorage.getItem(AB_STORAGE_KEY);
        if (stored === "a" || stored === "b") {
          abVariant = stored;
        } else {
          abVariant = Math.random() < 0.5 ? "a" : "b";
          localStorage.setItem(AB_STORAGE_KEY, abVariant);
        }
      }

      document.documentElement.setAttribute("data-ab-variant", abVariant);

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "experiment_impression",
        ab_experiment: "primary_cta_label",
        ab_variant: abVariant,
      });
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5GWNPPMP"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-lg focus-visible:bg-primary focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-medium focus-visible:text-primary-foreground focus-visible:ring-3 focus-visible:ring-ring/50"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      // GTM/GA4 testbed: a single delegated click listener reads any
      // `data-event` (+ other `data-*`) attributes off the clicked element
      // and pushes them to the dataLayer, so most interactions on this page
      // need no bespoke tracking code, just the right markup.
      window.dataLayer = window.dataLayer || [];

      // Only these keys are ever pulled from an element's dataset. Interactive
      // shadcn/Base UI components add their own internal `data-*` state
      // attributes (data-orientation, data-slot, data-value, ...) to the same
      // element; without an allowlist those would leak into every event.
      const TRACKED_PARAM_KEYS = [
        "ctaType",
        "featureName",
        "planName",
        "billingPeriod",
        "stepId",
        "autoplayState",
      ];

      document.addEventListener("click", (domEvent) => {
        const target = (
          domEvent.target as HTMLElement | null
        )?.closest<HTMLElement>("[data-event]");
        if (!target) return;

        const params: Record<string, string | undefined> = {};
        for (const key of TRACKED_PARAM_KEYS) {
          if (target.dataset[key] !== undefined)
            params[key] = target.dataset[key]!;
        }

        if (target.dataset.abExperiment) {
          // This CTA renders both label variants in the DOM (CSS picks which
          // one is visible), so textContent below would otherwise concatenate
          // both - read only the one matching the assigned variant instead.
          params.ab_experiment = target.dataset.abExperiment;
          const abVariant = document.documentElement.dataset.abVariant;
          if (abVariant) {
            params.ab_variant = abVariant;
            params.label =
              target
                .querySelector(`[data-ab-label="${abVariant}"]`)
                ?.textContent?.trim() ?? "";
          }
        } else {
          // agrega lo que necesites directamente aquí
          params.label = target.textContent?.trim() ?? "";

          // The dataLayer is cumulative, not scoped per push: GTM's Data
          // Layer Variables resolve against the whole merged dataLayer
          // state, not just the keys in the push that triggered them. The
          // page-load "experiment_impression" event (or an earlier click on
          // an experiment-tagged CTA) already set ab_experiment/ab_variant,
          // and they'd otherwise keep reading as "set" on every later click
          // that has nothing to do with the experiment. Explicitly clear
          // them so a GA4 tag mapped to these keys doesn't report an
          // experiment on clicks (e.g. the secondary "Pricing" CTA) that
          // were never part of it.
          params.ab_experiment = undefined;
          params.ab_variant = undefined;
        }

        window.dataLayer.push({ event: target.dataset.event, ...params });
      });
    </script>

    <script>
      // Progressive-enhancement scroll reveal for [data-reveal] elements.
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const revealTargets =
        document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        revealTargets.forEach((el) => el.classList.add("is-revealed"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );

        revealTargets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
