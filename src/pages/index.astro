---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import SocialProof from "@/components/sections/SocialProof.astro";
import Features from "@/components/sections/Features.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import Pricing from "@/components/sections/Pricing.astro";
import DemoForm from "@/components/sections/DemoForm.astro";
import { site } from "@/data/site";
---

<Layout title={`${site.name} - ${site.tagline}`} description={site.description}>
  <Hero />
  <SocialProof />
  <HowItWorks />
  <Pricing />
  <Features />
  <DemoForm />
</Layout>
