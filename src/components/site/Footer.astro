---
import { site } from '@/data/site';
import NewsletterSignup from '@/components/islands/NewsletterSignup.tsx';

const year = new Date().getFullYear();

const footerLinks = [
	{ href: '#features', label: 'Features' },
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#pricing', label: 'Pricing' },
	{ href: '#demo-request', label: 'Request a demo' },
];
---

<footer class="border-t border-border/60">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.1fr_0.9fr_1.2fr] md:items-start lg:px-8">
		<div>
			<p class="flex items-center gap-2 font-heading text-base font-semibold text-foreground">
				<span
					aria-hidden="true"
					class="flex h-6 w-6 items-center justify-center rounded-md bg-primary text-xs font-bold text-primary-foreground"
				>
					F
				</span>
				{site.name}
			</p>
			<p class="mt-2 max-w-sm text-sm text-gray-600 ">{site.tagline}</p>
		</div>

		<nav aria-label="Footer">
			<ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600 md:flex-col md:gap-y-3">
				{
					footerLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="rounded-sm transition-colors hover:text-foreground focus-visible:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<NewsletterSignup client:visible={{ rootMargin: '200px' }} />
		</div>
	</div>

	<div class="border-t border-border/60">
		<p class="mx-auto max-w-7xl px-4 py-4 text-xs text-gray-600  sm:px-6 lg:px-8">
			&copy; {year} {site.name}. A fictional product built for GTM/GA4 instrumentation testing; not a real
			company.
		</p>
	</div>
</footer>
