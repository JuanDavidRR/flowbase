---
import { Image } from "astro:assets";
import { Button } from "@/components/ui/button";
import Container from "@/components/site/Container.astro";
import flowbaseImage from "@/assets/images/flowbase.jpg";
---

<section
  class="max-w-7xl mx-auto relative overflow-hidden border-b border-border/60 gap-8 md:grid md:grid-cols-2 items-center text-center md:*:text-left"
  aria-labelledby="hero-heading"
>
  <section>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-24 -z-10 flex justify-center"
    >
      <div
        class="h-72 rounded-full bg-indigo-500/20 blur-3xl dark:bg-indigo-400/10"
      >
      </div>
    </div>

    <Container
      class="flex flex-col items-center md:items-start gap-6 py-20 sm:py-28 w-full"
    >
      <p
        data-reveal
        class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-gray-600"
      >
        Built for freelancers who bill by the call
      </p>

      <h1
        id="hero-heading"
        data-reveal
        class="max-w-3xl text-balance font-heading text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl"
      >
        Schedule and get paid, <span class="text-indigo-600"
          >from one link.</span
        >
      </h1>

      <p data-reveal class="max-w-xl text-pretty text-lg text-gray-600">
        Flowbase is the booking link built for freelancers: clients pick a time
        and pay upfront, so the money's already in your account when the call
        starts.
      </p>

      <div data-reveal class="flex flex-col gap-3 w-full sm:flex-row">
        <a
          href="#demo-request"
          class="cursor-pointer"
          data-event="cta_click"
          data-cta-type="primary"
        >
          <Button size="lg">Start free trial</Button>
        </a>
        <a
          href="#pricing"
          class="cursor-pointer"
          data-event="cta_click"
          data-cta-type="secondary"
        >
          <Button size="lg" variant="outline"> Pricing </Button>
        </a>
      </div>

      <p data-reveal class="text-xs text-gray-600 w-full">
        No credit card required &middot; 14-day free trial
      </p>
    </Container>
  </section>
  <section class="flex items-center justify-center mb-10">
    <Image
      src={flowbaseImage}
      alt="Flowbase demo"
      loading="eager"
      fetchpriority="high"
      widths={[400, 600, 900, 1200]}
      sizes="(min-width: 768px) 480px, 90vw"
      class="h-[80%] w-[80%] object-cover rounded-lg text-center"
    />
  </section>
</section>
