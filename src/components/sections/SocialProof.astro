---
import Container from '@/components/site/Container.astro';
import { logos } from '@/data/site';
---

<section aria-labelledby="social-proof-heading" class="border-b border-border/60 py-12 bg-indigo-800 text-white">
	<Container data-reveal class="flex flex-col items-center gap-6">
		<h2 id="social-proof-heading" class="text-center text-sm font-medium text-white ">
			Trusted by freelancers working with
		</h2>

		<ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
			{
				logos.map((logo) => (
					<li class="font-heading text-lg font-semibold tracking-tight text-white select-none">
						{logo}
					</li>
				))
			}
		</ul>
	</Container>
</section>
